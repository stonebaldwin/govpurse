{
  "name": "govpurse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Govpurse — self-serve SaaS aggregating local-government spending (checkbook payments, budgets, contracts) across jurisdictions: searchable, visual, with watchdog-grade analytics and alerts. Built on a reusable public-data ingestion engine (the Core).",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/web build",
    "dev": "pnpm --filter @govpurse/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @govpurse/db db:generate",
    "db:migrate": "pnpm --filter @govpurse/db db:migrate",
    "db:studio": "pnpm --filter @govpurse/db db:studio",
    "db:push": "pnpm --filter @govpurse/db db:push",
    "db:seed": "pnpm --filter @govpurse/db db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
