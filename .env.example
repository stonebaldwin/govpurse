# ============================================================================
# Govpurse — environment variables
# Copy to `.env` at the repo root (used by db tooling) and to
# `apps/web/.env.local` for the Next.js dev server. Never commit real secrets.
# In production, set these as Cloudflare Worker secrets (`wrangler secret put`).
# ============================================================================

# --- Database (Neon Postgres) ------------------------------------------------
# Use the POOLED connection string for the app; the neon-http driver runs over
# HTTPS (Workers cannot open raw TCP sockets).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/govpurse?sslmode=require"

# --- Auth (Better Auth) — wired in Phase 4 ----------------------------------
# Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Comma-separated emails allowed into the operator admin cockpit (/admin).
# Unset = nobody (the admin area 404s for everyone).
OPERATOR_EMAILS="ops@example.com"

# --- Data sources (Phase 1/6) -----------------------------------------------
# Socrata SODA needs NO key for public datasets. An optional app token raises
# rate limits when ingestion volume grows. Register at https://<portal>/profile/app_tokens
SOCRATA_APP_TOKEN=""

# --- Payments (Stripe) — wired in Phase 5 -----------------------------------
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# Price IDs (create in the Stripe dashboard; monthly + annual per paid tier)
STRIPE_PRICE_PRO_MONTHLY="price_xxx"
STRIPE_PRICE_PRO_ANNUAL="price_xxx"
STRIPE_PRICE_BUSINESS_MONTHLY="price_xxx"
STRIPE_PRICE_BUSINESS_ANNUAL="price_xxx"

# --- Email (Resend) — wired in Phase 4/6 ------------------------------------
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="Govpurse <noreply@govpurse.com>"
# Where ingestion-health / broken-adapter alerts are sent (the operator).
OPERATOR_ALERT_EMAIL="ops@example.com"

# --- Ingestion Worker (apps/ingest) — Phase 6 -------------------------------
# Set these as secrets on the `govpurse-ingest` Worker (`wrangler secret put`):
#   DATABASE_URL, SOCRATA_APP_TOKEN, RESEND_API_KEY, RESEND_FROM_EMAIL,
#   OPERATOR_ALERT_EMAIL, APP_URL
# APP_URL is the public site origin used in alert-email deep links.
APP_URL="http://localhost:3000"
# CLOUDFLARE_ACCOUNT_ID="xxx"
