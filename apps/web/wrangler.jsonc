{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "govpurse-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "govpurse-web",
    },
  ],
  "r2_buckets": [
    {
      // Next.js incremental (ISR) cache. Create once: `wrangler r2 bucket create govpurse-inc-cache`
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "govpurse-inc-cache",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  // Production secrets (DATABASE_URL, BETTER_AUTH_SECRET, STRIPE_*, RESEND_API_KEY)
  // are set with `wrangler secret put <NAME>` against the `govpurse-web` Worker.
}
